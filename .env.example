# Copie para .env.local (desenvolvimento) e cadastre as mesmas variáveis em
# Vercel > Settings > Environment Variables (produção).
#
# ⚠️ Nenhuma delas tem NEXT_PUBLIC_ no nome, e isso é proposital: variável com
# NEXT_PUBLIC_ vai embutida no JavaScript que o visitante baixa. A service_role
# key dá acesso total ao banco — ela só pode existir no servidor.

# ── Supabase ────────────────────────────────────────────────────────────
# Project Settings > API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── Notificação por e-mail (Resend) ─────────────────────────────────────
# Opcional: sem isto o lead ainda é salvo, você só não recebe o aviso.
# O remetente precisa ser de um domínio verificado no Resend.
RESEND_API_KEY=
LEAD_NOTIFY_FROM=ZXP Direciona <cadastro@seudominio.com.br>
LEAD_NOTIFY_TO=caualm4@gmail.com
